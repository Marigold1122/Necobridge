<Window x:Class="NekoBridge.Setup.InstallWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="安装 NekoBridge" Icon="Assets/nekobridge.ico" Width="760" Height="640" MinWidth="680" MinHeight="600" WindowStartupLocation="CenterScreen" ResizeMode="CanResize" Background="#FBF8F4" Foreground="#1B2130" FontFamily="Microsoft YaHei" FontSize="13" Closing="Window_Closing">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Background" Value="#1B2130"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="20,10"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="42"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#343B48"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="MinHeight" Value="42"/><Setter Property="Padding" Value="12,9"/><Setter Property="Background" Value="#FBF8F4"/><Setter Property="BorderBrush" Value="#D5D8CD"/><Setter Property="BorderThickness" Value="1"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 </Window.Resources>
 <Grid Margin="36,28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal" Margin="0,0,0,24"><Image Source="Assets/logo.png" Width="52" Height="52"/><StackPanel Margin="16,0,0,0"><TextBlock Text="安装 NekoBridge" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="SetupVersionText" Foreground="#72776F" Margin="0,6,0,0"/></StackPanel></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
   <StackPanel x:Name="DirectoryFields">
    <TextBlock Text="程序安装位置" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBox x:Name="InstallPath" AutomationProperties.AutomationId="InstallPath"/><Button Grid.Column="2" Content="浏览" Click="BrowseInstall_Click"/></Grid>
    <TextBlock Text="程序、快捷方式和在线更新所需文件。仅为当前 Windows 用户安装。" Foreground="#72776F" TextWrapping="Wrap" Margin="0,8,0,24"/>
    <TextBlock Text="数据保存位置" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBox x:Name="DataPath" AutomationProperties.AutomationId="DataPath"/><Button Grid.Column="2" Content="浏览" Click="BrowseData_Click"/></Grid>
    <TextBlock Text="配对、设置、剪贴板历史和离线文件副本。升级保留数据，不随程序卸载删除。" Foreground="#72776F" TextWrapping="Wrap" Margin="0,8,0,14"/>
    <Border x:Name="MigrationNotice" Padding="14" CornerRadius="10" Background="#EDF0E5" Margin="0,0,0,12"><TextBlock x:Name="ExistingDataText" TextWrapping="Wrap" Foreground="#526B2B"/></Border>
   </StackPanel>
   <TextBlock x:Name="StatusText" Text="选择目录后，点击安装。" TextWrapping="Wrap" Margin="0,8,0,12" Foreground="#4E5464" AutomationProperties.LiveSetting="Polite"/>
   <ProgressBar x:Name="InstallProgress" Height="4" Visibility="Collapsed" IsIndeterminate="True" Foreground="#8EA952" Background="#E7E9DF" BorderThickness="0"/>
   <TextBlock x:Name="CompletedPaths" TextWrapping="Wrap" Margin="0,14,0,0" Foreground="#526B2B"/>
  </StackPanel></ScrollViewer>
  <Grid Grid.Row="2" Margin="0,24,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="CancelButton" Grid.Column="1" Content="取消" Click="Cancel_Click"/><Button x:Name="InstallButton" Grid.Column="3" Content="安装" Click="Install_Click"/></Grid>
 </Grid>
</Window>
