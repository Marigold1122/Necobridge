<Window x:Class="NekoBridge.Windows.History.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="NekoBridge · 剪贴板"
        Height="640" Width="480"
        MinHeight="420" MinWidth="380"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="White" Foreground="#2E2E2E"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" ShowInTaskbar="False" PreviewKeyDown="OnPreviewKeyDown" Deactivated="OnWindowDeactivated">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
<Style x:Key="CopyButtonStyle" TargetType="Button">
    <Setter Property="Width" Value="24"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="Margin" Value="2,0,0,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="Button">
                <Border x:Name="bd" CornerRadius="4" Background="Transparent">
                    <Viewbox Width="13" Height="13"
                             HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <!-- 后层纸：左上折角 -->
                            <Path x:Name="iconBack"
                                  Data="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"
                                  Stroke="#B5B5B5" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <!-- 前层纸：右下圆角方框 -->
                            <Path x:Name="iconFront"
                                  Data="M10 8h10a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H10a2 2 0 0 1-2-2V10a2 2 0 0 1 2-2z"
                                  Stroke="#B5B5B5" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <!-- 复制成功后的对勾（默认隐藏） -->
                            <Path x:Name="iconCheck" Visibility="Collapsed"
                                  Data="M5 12.5l4.5 4.5L19 7.5"
                                  Stroke="#4CAF50" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="bd" Property="Background" Value="#F2F2F2"/>
                        <Setter TargetName="iconBack" Property="Stroke" Value="#8A8A8A"/>
                        <Setter TargetName="iconFront" Property="Stroke" Value="#8A8A8A"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="bd" Property="Background" Value="#E8E8E8"/>
                        <Setter TargetName="iconBack" Property="Stroke" Value="#6E6E6E"/>
                        <Setter TargetName="iconFront" Property="Stroke" Value="#6E6E6E"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                    </Trigger>
                    <!-- 复制成功后把 Tag 置为 CopyDone，短暂显示对勾 -->
                    <Trigger Property="Tag" Value="CopyDone">
                        <Setter TargetName="iconBack" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="iconFront" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="iconCheck" Property="Visibility" Value="Visible"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>

<BooleanToVisibilityConverter x:Key="BoolToVis"/>


        <!-- ============ 色板 ============ -->
        <SolidColorBrush x:Key="PanelBrush"     Color="#FAFAFA"/>
        <SolidColorBrush x:Key="LineBrush"      Color="#ECECEC"/>
        <SolidColorBrush x:Key="LineStrongBrush" Color="#E3E3E3"/>
        <SolidColorBrush x:Key="TextBrush"      Color="#2E2E2E"/>
        <SolidColorBrush x:Key="SubTextBrush"   Color="#9B9B9B"/>
        <SolidColorBrush x:Key="AccentBrush"    Color="#6FB43C"/>
        <SolidColorBrush x:Key="AccentPale"     Color="#EFF7E3"/>
        <SolidColorBrush x:Key="AccentText"     Color="#4E8A2A"/>

        <!-- ============ 标题栏按钮 ============ -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#7A7A7A"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="5" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F0F0F0"/>
                                <Setter Property="Foreground" Value="#333333"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E6E6E6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="5" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 分类胶囊 ============ -->
        <Style x:Key="PillStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#6E6E6E"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="6" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F3F3F3"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentPale}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentText}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 条目右上角：收藏 ============ -->
        <Style x:Key="FavToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" CornerRadius="4" Background="Transparent">
                            <TextBlock x:Name="glyph" Text="&#xE734;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="13" Foreground="#B5B5B5"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F2F2F2"/>
                                <Setter TargetName="glyph" Property="Foreground" Value="#8A8A8A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="glyph" Property="Text" Value="&#xE735;"/>
                                <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 条目右上角：删除 ============ -->
        <Style x:Key="DeleteButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="4" Background="Transparent">
                            <TextBlock x:Name="glyph" Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="13" Foreground="#B5B5B5"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FDECEC"/>
                                <Setter TargetName="glyph" Property="Foreground" Value="#D9534F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 设置齿轮（收起 / 展开） ============ -->
        <Style x:Key="GearToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" CornerRadius="5" Background="Transparent">
                            <TextBlock x:Name="glyph" Text="&#xE713;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="13" Foreground="#9B9B9B"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F0F0F0"/>
                                <Setter TargetName="glyph" Property="Foreground" Value="#5F5F5F"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentPale}"/>
                                <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource AccentText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 细滚动条 ============ -->
        <Style x:Key="SlimScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="3" Background="#D8D8D8"
                                                        Width="6" HorizontalAlignment="Right" Margin="0,2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 条目卡片模板 ============ -->
        <DataTemplate x:Key="ClipItemTemplate">
            <Border x:Name="Card" Margin="0,0,0,8" CornerRadius="8"
                    Padding="12,9" Focusable="False" Cursor="Hand">

                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FCFDF9"/>
                                <Setter Property="BorderBrush" Value="#DBEBC6"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 头部：类型 · 元信息 ·（收藏 / 删除） -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#F4F4F4" CornerRadius="4"
                                Padding="6,1" VerticalAlignment="Center">
                            <TextBlock FontSize="11" Foreground="#7A7A7A">
                              <TextBlock.Style><Style TargetType="TextBlock">
                                <Setter Property="Text" Value="文本"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Kind}" Value="Image"><Setter Property="Text" Value="图片"/></DataTrigger>
                                  <DataTrigger Binding="{Binding Kind}" Value="Files"><Setter Property="Text" Value="文件"/></DataTrigger>
                                </Style.Triggers>
                              </Style></TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <TextBlock Grid.Column="1" FontSize="11"
                                   Foreground="{StaticResource SubTextBrush}"
                                   Margin="8,0,8,0" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Text><MultiBinding StringFormat="{}{0} · {1}"><Binding Path="Meta"/><Binding Path="TimeLabel"/></MultiBinding></TextBlock.Text>
                        </TextBlock>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
    <Button Style="{StaticResource CopyButtonStyle}"
            Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
            CommandParameter="{Binding}"
            ToolTip="复制"/>
    <ToggleButton Style="{StaticResource FavToggleStyle}"
                  IsChecked="{Binding IsFavorite, Mode=OneWay}"
                  Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                  ToolTip="收藏"/>
    <Button Style="{StaticResource DeleteButtonStyle}"
            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
            ToolTip="删除"/>
</StackPanel>

                    </Grid>

                    <!-- 内容区：文本 / 图片 / 文件 三选一 -->
                    <Grid Grid.Row="1" Margin="0,7,0,0">

                        <!-- 文本 -->
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis" MaxHeight="56"
                                   LineHeight="19" Foreground="#3A3A3A">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="Image">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Files">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- 图片缩略图 -->
                        <Border MaxHeight="96" HorizontalAlignment="Left" CornerRadius="6"
                                ClipToBounds="True">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="Image">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Image Source="{Binding ThumbPath}" MaxHeight="96" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>

                        <!-- 文件 -->
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="Files">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource AccentPale}">
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="{StaticResource AccentText}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                       Margin="8,0,0,0" Foreground="#3A3A3A"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- ================= 窗口外框 ================= -->
    <Border Background="White"
            BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>   <!-- 标题栏 -->
                <RowDefinition Height="1"/>    <!-- 分隔线 -->
                <RowDefinition Height="Auto"/> <!-- 段落标题 -->
                <RowDefinition Height="Auto"/> <!-- 搜索 -->
                <RowDefinition Height="Auto"/> <!-- 分类 -->
                <RowDefinition Height="Auto"/> <!-- 设置（收起） -->
                <RowDefinition Height="*"/>    <!-- 列表 -->
                <RowDefinition Height="32"/>   <!-- 状态栏 -->
            </Grid.RowDefinitions>

            <!-- ===== 标题栏 ===== -->
            <Grid Grid.Row="0" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border Width="12" Height="12" CornerRadius="3" Background="{StaticResource AccentBrush}"/>
                    <TextBlock Text="NekoBridge" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="0.3.1" FontSize="11" Foreground="{StaticResource SubTextBrush}"
                               Margin="7,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="24,0,0,0">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="仅本机 · 剪贴板" FontSize="12"
                               Foreground="{StaticResource SubTextBrush}" Margin="6,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,10,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButtonStyle}" Content="&#xE921;"
                            ToolTip="最小化"
                            Click="OnMinimizeClick"/>
                    <Button Style="{StaticResource CaptionButtonStyle}" Content="&#xE922;"
                            ToolTip="最大化"
                            Click="OnMaximizeClick"/>
                    <Button Style="{StaticResource CloseButtonStyle}" Content="&#xE8BB;"
                            ToolTip="关闭"
                            Command="{Binding CloseCommand}"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource LineBrush}"/>

            <!-- ===== 段落标题 ===== -->
            <Grid Grid.Row="2" Margin="16,14,16,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="01" FontSize="12" Foreground="#C0C0C0" VerticalAlignment="Center"/>
                    <Border Width="1" Height="11" Background="{StaticResource LineStrongBrush}"
                            Margin="8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="剪贴板历史" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding FilteredItems.Count, StringFormat={}{0} 条}" FontSize="11" Foreground="{StaticResource SubTextBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- ===== 搜索 ===== -->
            <Border Grid.Row="3" Height="36" Margin="16,0,16,0" CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchBox}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Background" Value="White"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Foreground="#A8A8A8" VerticalAlignment="Center" Margin="11,0,8,0"/>

                    <Grid Grid.Column="1">
                        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=120}" BorderThickness="0" Background="Transparent"
                                 Margin="0,0,10,0" VerticalContentAlignment="Center"
                                 Foreground="{StaticResource TextBrush}" FontSize="12.5"/>

                        <TextBlock Text="搜索文本、图片或文件…" Foreground="#B5B5B5" FontSize="12.5"
                                   VerticalAlignment="Center" IsHitTestVisible="False" Margin="2,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <!-- ===== 分类 + 设置齿轮 ===== -->
            <Grid Grid.Row="4" Margin="16,12,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="全部" Tag="全部" Checked="OnFilterChecked" GroupName="Filter" IsChecked="True" Style="{StaticResource PillStyle}"/>
                    <RadioButton Content="文本" Tag="文本" Checked="OnFilterChecked" GroupName="Filter" Style="{StaticResource PillStyle}"/>
                    <RadioButton Content="图片" Tag="图片" Checked="OnFilterChecked" GroupName="Filter" Style="{StaticResource PillStyle}"/>
                    <RadioButton Content="文件" Tag="文件" Checked="OnFilterChecked" GroupName="Filter" Style="{StaticResource PillStyle}"/>
                    <RadioButton Content="收藏" Tag="收藏" Checked="OnFilterChecked" GroupName="Filter" Style="{StaticResource PillStyle}"/>
                </StackPanel>

                <ToggleButton x:Name="SettingsToggle" Grid.Column="1"
                              Style="{StaticResource GearToggleStyle}" ToolTip="设置" IsChecked="{Binding IsSettingsOpen, Mode=OneWay}" Click="OnSettingsToggleClick"/>
            </Grid>

            <!-- ===== 设置面板（默认收起） ===== -->
<Border Grid.Row="5" Margin="16,10,16,0" Padding="12,10" CornerRadius="8"
        Background="{StaticResource PanelBrush}"
        BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
    <Border.Style>
        <Style TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Border.Style>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
    <TextBlock Text="记录条数上限" FontSize="12" Foreground="#666666" VerticalAlignment="Center"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <TextBox Width="64" Height="24" FontSize="12" TextAlignment="Right"
                 VerticalContentAlignment="Center" Padding="4,0"
                 Background="White" BorderBrush="{StaticResource LineStrongBrush}"
                 PreviewTextInput="OnMaxItemsPreviewTextInput" DataObject.Pasting="OnMaxItemsPasting"
                 Text="{Binding MaxItems, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="条（0 为不限）" Margin="8,0,0,0" FontSize="12" Foreground="#666666"
                   VerticalAlignment="Center"/>
    </StackPanel>
</Grid>


        <Grid Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="记录图片" FontSize="12" Foreground="#666666" VerticalAlignment="Center"/>
            <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"
                      IsChecked="{Binding CaptureImages, Mode=TwoWay}"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Text="记录文件" FontSize="12" Foreground="#666666" VerticalAlignment="Center"/>
            <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"
                      IsChecked="{Binding CaptureFiles, Mode=TwoWay}"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="呼出快捷键" FontSize="12" Foreground="#666666" VerticalAlignment="Center"/>
            <Button x:Name="HotkeyRecorder" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Cursor="Hand" Focusable="True"
                    Command="{Binding BeginRecordingCommand}"
                    PreviewKeyDown="OnHotkeyRecorderKeyDown">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="4" Background="White"
                                BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1"
                                Padding="8,2">
                            <TextBlock Text="{Binding HotkeyText}" FontSize="11" Foreground="#666666"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <Grid Grid.Row="4">
            <Button HorizontalAlignment="Left" Content="清空记录" FontSize="12"
                    Height="26" Padding="12,0" Foreground="#D9534F"
                    Background="White" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1"
                    Command="{Binding ClearAllCommand}"/>
            <Button HorizontalAlignment="Right" Content="完成" FontSize="12"
                    Height="26" Padding="16,0"
                    Background="White" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1"
                    Command="{Binding CloseSettingsCommand}"/>
        </Grid>
    </Grid>
</Border>

            <!-- ===== 列表 ===== -->
            <Grid Grid.Row="6" Margin="16,10,16,0">
<Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ListBox x:Name="ClipList" Background="Transparent" BorderThickness="0" Padding="0,0,6,0"
                         ItemsSource="{Binding FilteredItems}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         ItemTemplate="{StaticResource ClipItemTemplate}" MouseDoubleClick="OnItemDoubleClick"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/></ListBox.Resources>
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                      <Setter Property="Padding" Value="0"/>
                      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
                      <Setter Property="ContextMenu"><Setter.Value>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                          <MenuItem Header="仅复制" Command="{Binding Tag.CopyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                          <MenuItem Header="保存文件离线副本…" Command="{Binding Tag.SaveCopyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                        </ContextMenu>
                      </Setter.Value></Setter>
                      <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </Style></ListBox.ItemContainerStyle>
                </ListBox>
<Button Grid.Row="1" Content="加载更多"
        HorizontalAlignment="Center"
        Margin="0,10,0,10"
        MinWidth="120" Height="28" Padding="16,0" FontSize="12"
        Foreground="#2563EB" Background="White"
        BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1"
        Cursor="Hand"
        Command="{Binding LoadMoreCommand}"
        Visibility="{Binding HasMore, Converter={StaticResource BoolToVis}}"/>


                <TextBlock Text="暂无记录" FontSize="12" Foreground="#BFBFBF"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems, ElementName=ClipList}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- ===== 状态栏 ===== -->
            <Border Grid.Row="7" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="16,0">
                    <TextBlock Text="{Binding FilteredItems.Count, StringFormat=共 {0} 条 · 本地存储}" FontSize="11"
                               Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="双击或 Enter 使用" FontSize="11"
                               Foreground="{StaticResource SubTextBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>