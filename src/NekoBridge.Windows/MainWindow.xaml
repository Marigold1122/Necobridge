<Window x:Class="NekoBridge.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NekoBridge" Icon="/NekoBridge;component/Assets/nekobridge.ico" Height="744" Width="1136" MinHeight="624" MinWidth="960"
        WindowStyle="None" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Paper}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" TextOptions.TextFormattingMode="Ideal"
        StateChanged="Window_StateChanged" SourceInitialized="Window_SourceInitialized">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 色板：运行时由 ApplyTheme 替换，全部以 DynamicResource 引用 -->
        <SolidColorBrush x:Key="Ink" Color="#1B2130"/>   <SolidColorBrush x:Key="Ink70" Color="#4E5464"/>
        <SolidColorBrush x:Key="Muted" Color="#8B8A93"/> <SolidColorBrush x:Key="Paper" Color="#FBF8F4"/>
        <SolidColorBrush x:Key="Paper2" Color="#F1EBE4"/><SolidColorBrush x:Key="Line" Color="#E0D8CF"/>
        <SolidColorBrush x:Key="Lime" Color="#AFDC3C"/>  <SolidColorBrush x:Key="LimeDeep" Color="#58790F"/>
        <SolidColorBrush x:Key="LimeWash" Color="#EFF7DB"/><SolidColorBrush x:Key="Vein" Color="#9E3B38"/>

        <!-- 图标：16 网格 · 1.5px · 圆头 -->
        <Geometry x:Key="IcoMin">M3,8.5 H13</Geometry>
        <Geometry x:Key="IcoMax">M3.5,3.5 H12.5 V12.5 H3.5 Z</Geometry>
        <Geometry x:Key="IcoRestore">M5.5,3.5 H12.5 V10.5 M3.5,5.5 H10.5 V12.5 H3.5 Z</Geometry>
        <Geometry x:Key="IcoClose">M4,4 L12,12 M12,4 L4,12</Geometry>
        <Geometry x:Key="IcoPause">M6,4 V12 M10,4 V12</Geometry>
        <Geometry x:Key="IcoPlay">M5.5,3.5 L12,8 L5.5,12.5 Z</Geometry>
        <Geometry x:Key="IcoArrow">M3,8 H13 M9,4 L13,8 L9,12</Geometry>

        <Style x:Key="IconPath" TargetType="Path">
            <Setter Property="Width" Value="16"/><Setter Property="Height" Value="16"/><Setter Property="Stretch" Value="None"/>
            <Setter Property="StrokeThickness" Value="1.5"/><Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/><Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Stroke" Value="{DynamicResource Ink70}"/>
        </Style>

        <Style x:Key="FocusRing"><Setter Property="Control.Template"><Setter.Value><ControlTemplate>
            <Rectangle Margin="-3" RadiusX="3" RadiusY="3" Stroke="{DynamicResource LimeDeep}" StrokeThickness="2"/>
        </ControlTemplate></Setter.Value></Setter></Style>

        <!-- 字阶：10.5 / 11 / 12 / 12.5 / 16 / 24，行高 8 的倍数 -->
        <Style x:Key="Mono" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Microsoft YaHei UI"/><Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/><Setter Property="LineHeight" Value="16"/><Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Height" Value="40"/><Setter Property="Cursor" Value="Hand"/><Setter Property="GroupName" Value="Nav"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Grid x:Name="Bg" Background="Transparent">
                    <Rectangle x:Name="Bar" Width="3" HorizontalAlignment="Left" Fill="Transparent"/>
                    <StackPanel Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="Num" Text="{TemplateBinding Tag}" Style="{StaticResource Mono}" Width="24"/>
                        <TextBlock x:Name="Txt" Text="{TemplateBinding Content}" FontSize="12.5" Foreground="{DynamicResource Ink70}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource Ink}"/></Trigger>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource LimeWash}"/>
                        <Setter TargetName="Bar" Property="Fill" Value="{DynamicResource Lime}"/>
                        <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource Ink}"/>
                        <Setter TargetName="Txt" Property="FontWeight" Value="SemiBold"/>
                        <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource LimeDeep}"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="16,0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11.5"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Paper}"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Bd" Background="{DynamicResource Ink}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ink70}"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.35"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="Chrome" TargetType="Button">
            <Setter Property="Width" Value="46"/><Setter Property="Height" Value="40"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Bd" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Paper2}"/></Trigger>
                    <Trigger Property="Tag" Value="hot"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Paper2}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="Square" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="11.5"/><Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <StackPanel Orientation="Horizontal" Background="Transparent">
                    <Border x:Name="Box" Width="16" Height="16" CornerRadius="2" BorderThickness="1" BorderBrush="{DynamicResource Muted}" Background="Transparent">
                        <Path x:Name="Tick" Data="M3.5,8 L6.5,11 L12.5,4.5" Style="{StaticResource IconPath}" Width="14" Height="14" Stroke="{DynamicResource Ink}" Visibility="Collapsed"/></Border>
                    <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Box" Property="Background" Value="{DynamicResource Lime}"/>
                        <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource LimeDeep}"/>
                        <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="Tick" Property="Stroke" Value="#1B2130"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Ink}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <ControlTemplate x:Key="FieldTemplate" TargetType="Control">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}">
                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
            </Border>
        </ControlTemplate>
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="11.5"/><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="8,4"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="CaretBrush" Value="{DynamicResource Ink}"/>
            <Setter Property="Background" Value="{DynamicResource Paper}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Lime}"/><Setter Property="Template" Value="{StaticResource FieldTemplate}"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="FontSize" Value="11.5"/><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="8,4"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="CaretBrush" Value="{DynamicResource Ink}"/>
            <Setter Property="Background" Value="{DynamicResource Paper}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Lime}"/><Setter Property="Template" Value="{StaticResource FieldTemplate}"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource Paper}"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="11.5"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <!-- 顶栏 -->
        <Grid Grid.ColumnSpan="2" Background="{DynamicResource Paper}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"/>
            <Grid Margin="24,0,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="216"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/NekoBridge;component/Assets/logo.png" Width="24" Height="24" Stretch="Uniform"/>
                    <TextBlock Text="NekoBridge" Margin="8,0,0,0" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
                    <TextBlock Text="1.1.2" Style="{StaticResource Mono}" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="32,0,0,0" VerticalAlignment="Center">
                    <Ellipse x:Name="StateDot" Width="8" Height="8" StrokeThickness="1.5" Stroke="{DynamicResource Muted}"/>
                    <TextBlock x:Name="StateText" AutomationProperties.AutomationId="StateText" Margin="8,0,0,0" FontSize="11.5" Foreground="{DynamicResource Ink70}" VerticalAlignment="Center"/>
                    <Rectangle Width="1" Height="12" Fill="{DynamicResource Line}" Margin="16,0"/>
                    <TextBlock x:Name="StateSub" Style="{StaticResource Mono}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <ToggleButton x:Name="PauseToggle" AutomationProperties.AutomationId="PauseToggle" Width="96" Height="32" Margin="0,12,16,0" Cursor="Hand" VerticalAlignment="Top"
                                  FocusVisualStyle="{StaticResource FocusRing}" AutomationProperties.Name="暂停共享"
                                  ToolTip="暂停键鼠共享并取消当前原生拖放" Checked="Pause_Changed" Unchecked="Pause_Changed">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bd" CornerRadius="2" BorderThickness="1" Background="Transparent" BorderBrush="{DynamicResource Line}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path x:Name="IcoPause" Data="{DynamicResource IcoPause}" Style="{StaticResource IconPath}" Stroke="{DynamicResource Ink}"/>
                                    <Path x:Name="IcoPlay" Data="{DynamicResource IcoPlay}" Style="{StaticResource IconPath}" Stroke="{x:Null}" Fill="{DynamicResource Lime}" Visibility="Collapsed"/>
                                    <TextBlock x:Name="Lbl" Text="暂停" Margin="4,0,0,0" FontSize="11.5" Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ink70}"/></Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ink}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ink}"/>
                                    <Setter TargetName="Lbl" Property="Text" Value="已暂停"/>
                                    <Setter TargetName="Lbl" Property="Foreground" Value="{DynamicResource Paper}"/>
                                    <Setter TargetName="IcoPause" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="IcoPlay" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <Button Style="{StaticResource Chrome}" Click="Min_Click" AutomationProperties.Name="最小化">
                        <Path Data="{DynamicResource IcoMin}" Style="{StaticResource IconPath}"/></Button>
                    <Button x:Name="MaxBtn" Style="{StaticResource Chrome}" Click="Max_Click" AutomationProperties.Name="最大化">
                        <Path x:Name="MaxPath" Data="{DynamicResource IcoMax}" Style="{StaticResource IconPath}"/></Button>
                    <Button Style="{StaticResource Chrome}" Click="Close_Click" AutomationProperties.Name="关闭">
                        <Path Data="{DynamicResource IcoClose}" Style="{StaticResource IconPath}"/></Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 左栏 -->
        <Grid Grid.Row="1">
            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0"/>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Height="160" Margin="24,24,24,24" CornerRadius="2" BorderThickness="1" BorderBrush="{DynamicResource Line}">
                    <Border.Background>
                        <ImageBrush x:Name="DeviceWallpaper" Stretch="UniformToFill"/>
                    </Border.Background>
                    <Border VerticalAlignment="Bottom" Background="{DynamicResource Paper}" Padding="8,8">
                        <StackPanel>
                            <TextBlock x:Name="SideHost" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="SideIp" Style="{StaticResource Mono}" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Border>
                <StackPanel Grid.Row="1" AutomationProperties.Name="导航">
                    <RadioButton x:Name="NavConn" AutomationProperties.AutomationId="NavConn" Style="{StaticResource NavItem}" Tag="01" Content="连接" Checked="Nav_Checked" IsChecked="True"/>
                    <RadioButton x:Name="NavArr" AutomationProperties.AutomationId="NavArr" Style="{StaticResource NavItem}" Tag="02" Content="屏幕排列" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavSet" AutomationProperties.AutomationId="NavSet" Style="{StaticResource NavItem}" Tag="03" Content="设置" Checked="Nav_Checked"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Margin="24,0,24,24">
                    <Rectangle Height="1" Fill="{DynamicResource Line}" Margin="0,0,0,16"/>
                    <TextBlock Text="TLS 配对 · 局域网" Style="{StaticResource Mono}" HorizontalAlignment="Left"/>
                    <TextBlock Text="Ctrl+Alt+Home 返回本机" Style="{StaticResource Mono}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 主区：统一容器，左对齐轴 32，最大宽 960 -->
        <Grid x:Name="MainContent" Grid.Row="1" Grid.Column="1" Margin="32,24,32,24" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <TextBlock x:Name="PageNum" Text="02" Style="{StaticResource Mono}" Foreground="{DynamicResource LimeDeep}" FontSize="11"/>
                <Rectangle Width="1" Height="12" Fill="{DynamicResource Line}" Margin="8,0"/>
                <TextBlock x:Name="PageTitle" Text="屏幕排列" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
            </StackPanel>

            <!-- 01 连接：按已确认 HTML 移植，样式仅作用于连接页 -->
            <Grid x:Name="PanelConn" Grid.Row="1" Visibility="Collapsed" TextElement.FontFamily="Microsoft YaHei" TextOptions.TextFormattingMode="Display">
                <Grid.Resources>
                    <Style x:Key="ConnectionButton" TargetType="Button">
                        <Setter Property="MinHeight" Value="48"/><Setter Property="Padding" Value="24,12"/>
                        <Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Foreground" Value="White"/><Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                            <Border x:Name="Surface" Background="#1B2130" CornerRadius="12" Padding="{TemplateBinding Padding}" BorderThickness="2" BorderBrush="#1B2130">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#343B48"/><Setter TargetName="Surface" Property="BorderBrush" Value="#343B48"/></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#101621"/></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate></Setter.Value></Setter>
                    </Style>
                    <Style x:Key="ConnectionLink" TargetType="Button" BasedOn="{StaticResource ConnectionButton}">
                        <Setter Property="Foreground" Value="{DynamicResource Ink70}"/><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="12,10"/>
                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                            <Border x:Name="Surface" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Paper2}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
                        </ControlTemplate></Setter.Value></Setter>
                    </Style>
                    <Style x:Key="PeerIcon" TargetType="Button">
                        <Setter Property="Width" Value="42"/><Setter Property="Height" Value="42"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="{DynamicResource Ink70}"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="IconBg" CornerRadius="10" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="IconBg" Property="Background" Value="{DynamicResource LimeWash}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="IconBg" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
                    </Style>
                    <Style x:Key="ConnectionRole" TargetType="Button">
                        <Setter Property="MinHeight" Value="210"/><Setter Property="Padding" Value="26"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                        <Setter Property="Background" Value="{DynamicResource Paper2}"/><Setter Property="BorderBrush" Value="#A9B394"/><Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" CornerRadius="22" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource LimeWash}"/><Setter TargetName="Surface" Property="BorderBrush" Value="#879571"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
                        </ControlTemplate></Setter.Value></Setter>
                    </Style>
                    <Style x:Key="ConnectionCaption" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="LineHeight" Value="25"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="{DynamicResource Ink70}"/></Style>
                    <Style x:Key="ConnectionHeading" TargetType="TextBlock"><Setter Property="FontSize" Value="26"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Margin" Value="0,0,0,18"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
                    <Style x:Key="ConnectionFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource ConnectionCaption}"><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,14,0,8"/></Style>
                    <Style x:Key="ConnectionField" TargetType="Control"><Setter Property="FontSize" Value="15"/><Setter Property="MinHeight" Value="48"/><Setter Property="Padding" Value="14,10"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource Paper}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" CornerRadius="11" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
                    <Style x:Key="ConnectionBall" TargetType="Border"><Setter Property="Width" Value="48"/><Setter Property="Height" Value="48"/><Setter Property="CornerRadius" Value="24"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="Background" Value="{DynamicResource Paper}"/></Style>
                    <Style x:Key="ConnectionNumber" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/></Style>
                    <Style x:Key="ConnectionInfo" TargetType="Border"><Setter Property="Padding" Value="22,18"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Background" Value="{DynamicResource Paper2}"/></Style>
                </Grid.Resources>
                <ScrollViewer x:Name="ConnectionScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="ConnectionScroll_SizeChanged">
                    <Grid x:Name="ConnectionCanvas" Margin="12,0,12,12">
                        <Button x:Name="ReturnDevicesButton" Panel.ZIndex="5" Style="{StaticResource ConnectionLink}" Content="← 返回设备列表" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Click="ReturnDevices_Click"/>
                        <Grid x:Name="ConnectionIntro" VerticalAlignment="Center" Margin="24,64,24,32">
                            <StackPanel>
                                <TextBlock Text="NEKOBRIDGE / CONNECT" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource LimeDeep}" Margin="0,0,0,24"/>
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,0,0,44"><TextBlock Text="这台主机是作为…" FontSize="52" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/></Viewbox>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Button x:Name="ControllerRoleButton" AutomationProperties.AutomationId="ControllerRoleButton" Style="{StaticResource ConnectionRole}" Click="ControllerRole_Click" Background="{DynamicResource LimeWash}">
                                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <TextBlock Text="01 / CONTROL" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource LimeDeep}"/>
                                            <Path Data="M3,3 H46 V31 H3 Z M17,40 H35 M25,31 V40 M50,28 H57 V42 H50 Z M53.5,28 V33" Stroke="{DynamicResource LimeDeep}" StrokeThickness="1.4" Width="56" Height="44" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                            <TextBlock Grid.Row="1" Text="控制端" FontSize="30" FontWeight="SemiBold" Margin="0,38,0,10"/>
                                            <TextBlock Grid.Row="2" Text="键鼠插在这台主机上" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource Ink70}" Margin="0,0,32,0"/>
                                            <TextBlock Grid.Row="2" Text="↗" FontSize="24" HorizontalAlignment="Right" Foreground="{DynamicResource LimeDeep}"/>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="ReceiverRoleButton" AutomationProperties.AutomationId="ReceiverRoleButton" Grid.Column="2" Style="{StaticResource ConnectionRole}" Click="ReceiverRole_Click">
                                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <TextBlock Text="02 / RECEIVE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource LimeDeep}"/>
                                            <Path Data="M11,3 H54 V32 H11 Z M24,41 H42 M33,32 V41 M2,17 H22 M16,11 L22,17 L16,23" Stroke="{DynamicResource LimeDeep}" StrokeThickness="1.4" Width="56" Height="44" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                            <TextBlock Grid.Row="1" Text="被控端" FontSize="30" FontWeight="SemiBold" Margin="0,38,0,10"/>
                                            <TextBlock Grid.Row="2" Text="使用另一台主机的键鼠" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource Ink70}" Margin="0,0,32,0"/>
                                            <TextBlock Grid.Row="2" Text="↗" FontSize="24" HorizontalAlignment="Right" Foreground="{DynamicResource LimeDeep}"/>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Grid>
                        <StackPanel x:Name="ConnectionSteps" Visibility="Collapsed" Margin="24,64,24,28">
                            <Grid Margin="0,0,0,28"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock x:Name="ConnectionRoleHint" FontSize="11" Foreground="{DynamicResource LimeDeep}" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBlock x:Name="ConnectionFlowTitle" FontSize="32" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/></StackPanel>
                                <Button x:Name="ChangeRoleButton" Grid.Column="1" Style="{StaticResource ConnectionLink}" Content="← 重新选择角色" VerticalAlignment="Top" Click="ChangeConnectionRole_Click"/>
                            </Grid>
                            <Border CornerRadius="20" Background="{DynamicResource Paper2}" Padding="10,22" Margin="0,0,0,32">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Line Grid.ColumnSpan="2" X1="0" X2="1" Y1="0" Y2="0" Stretch="Fill" Stroke="#AAB09F" StrokeThickness="1" StrokeDashArray="3,4" VerticalAlignment="Top" Margin="70,24,70,0" IsHitTestVisible="False"/>
                                    <Line Grid.Column="1" Grid.ColumnSpan="2" X1="0" X2="1" Y1="0" Y2="0" Stretch="Fill" Stroke="#AAB09F" StrokeThickness="1" StrokeDashArray="3,4" VerticalAlignment="Top" Margin="70,24,70,0" IsHitTestVisible="False"/>
                                    <StackPanel><Border x:Name="ConnectionBallOne" Style="{StaticResource ConnectionBall}"><TextBlock x:Name="ConnectionNumberOne" Text="01" Style="{StaticResource ConnectionNumber}"/></Border><TextBlock x:Name="ConnectionLabelOne" Text="准备对方主机" FontSize="13" HorizontalAlignment="Center" Margin="0,14,0,0" Foreground="{DynamicResource Ink70}"/></StackPanel>
                                    <StackPanel Grid.Column="1"><Border x:Name="ConnectionBallTwo" Style="{StaticResource ConnectionBall}"><TextBlock x:Name="ConnectionNumberTwo" Text="02" Style="{StaticResource ConnectionNumber}"/></Border><TextBlock x:Name="ConnectionLabelTwo" Text="填写连接信息" FontSize="13" HorizontalAlignment="Center" Margin="0,14,0,0" Foreground="{DynamicResource Ink70}"/></StackPanel>
                                    <StackPanel Grid.Column="2"><Border x:Name="ConnectionBallThree" Style="{StaticResource ConnectionBall}"><TextBlock x:Name="ConnectionNumberThree" Text="03" Style="{StaticResource ConnectionNumber}"/></Border><TextBlock x:Name="ConnectionLabelThree" Text="连接完成" FontSize="13" HorizontalAlignment="Center" Margin="0,14,0,0" Foreground="{DynamicResource Ink70}"/></StackPanel>
                                </Grid>
                            </Border>
                            <Grid x:Name="ConnectionWorkArea" MinHeight="260" Margin="12,0">
                                <StackPanel x:Name="ConnectionStepOne">
                                    <TextBlock x:Name="PrepareTitle" Style="{StaticResource ConnectionHeading}"/>
                                    <TextBlock x:Name="PrepareBody" Style="{StaticResource ConnectionCaption}" Margin="0,0,0,26"/>
                                    <Button x:Name="CardAction" AutomationProperties.AutomationId="CardAction" Style="{StaticResource ConnectionButton}" HorizontalAlignment="Left" Content="开启配对 →" Click="Pairing_Click"/>
                                    <Button x:Name="PreparedButton" Style="{StaticResource ConnectionButton}" HorizontalAlignment="Left" Content="对方已开启，下一步 →" Click="Prepared_Click" Visibility="Collapsed"/>
                                </StackPanel>
                                <StackPanel x:Name="ConnectionStepTwo" Visibility="Collapsed">
                                    <TextBlock x:Name="ConnectStepTitle" Style="{StaticResource ConnectionHeading}"/>
                                    <StackPanel x:Name="ReceiverDetails" Visibility="Collapsed">
                                        <TextBlock Text="回到控制端，填写下面的地址和安全密钥。" Style="{StaticResource ConnectionCaption}" Margin="0,0,0,20"/>
                                        <Border Style="{StaticResource ConnectionInfo}" Margin="0,0,0,14"><StackPanel><TextBlock Text="本机地址" Style="{StaticResource ConnectionCaption}" FontSize="12"/><TextBlock x:Name="LocalPairingAddress" FontSize="17" Foreground="{DynamicResource Ink}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
                                        <Border Style="{StaticResource ConnectionInfo}"><StackPanel><TextBlock Text="安全密钥" Style="{StaticResource ConnectionCaption}" FontSize="12"/><TextBox x:Name="PairingCodeText" AutomationProperties.AutomationId="PairingCodeText" IsReadOnly="True" TextWrapping="Wrap" FontSize="17" Background="Transparent" BorderThickness="0" Padding="0,8,0,0" AutomationProperties.Name="本机安全配对密钥"><TextBox.Template><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost"/></ControlTemplate></TextBox.Template></TextBox></StackPanel></Border>
                                        <TextBlock x:Name="PairingWaitText" Style="{StaticResource ConnectionCaption}" Foreground="{DynamicResource LimeDeep}" Margin="0,20,0,0"/>
                                        <WrapPanel Margin="0,20,0,0"><Button Style="{StaticResource ConnectionButton}" Content="复制连接信息" Click="CopyPairingInfo_Click" Margin="0,0,12,8"/><Button Style="{StaticResource ConnectionLink}" Content="关闭配对" Click="Pairing_Click" Margin="0,0,0,8"/></WrapPanel>
                                    </StackPanel>
                                    <StackPanel x:Name="ControllerDetails" Visibility="Collapsed">
                                        <Button x:Name="NearbyButton" AutomationProperties.AutomationId="NearbyButton" Style="{StaticResource ConnectionButton}" Content="查找附近设备" HorizontalAlignment="Left" Click="Discover_Click"/>
                                        <ListBox x:Name="NearbyList" AutomationProperties.AutomationId="NearbyList" DisplayMemberPath="Display" SelectionChanged="Nearby_SelectionChanged" AutomationProperties.Name="附近设备" FontSize="15" Margin="0,14,0,0" MaxHeight="110"/>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="对方地址" Style="{StaticResource ConnectionFieldLabel}"/><TextBox x:Name="JoinAddress" AutomationProperties.AutomationId="JoinAddress" Style="{StaticResource ConnectionField}" AutomationProperties.Name="对方地址"/></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock Text="安全密钥" Style="{StaticResource ConnectionFieldLabel}"/><PasswordBox x:Name="JoinCode" AutomationProperties.AutomationId="JoinCode" Style="{StaticResource ConnectionField}" AutomationProperties.Name="对方安全配对密钥"/></StackPanel>
                                        </Grid>
                                        <WrapPanel Margin="0,24,0,0"><Button x:Name="ConnectButton" AutomationProperties.AutomationId="ConnectButton" Style="{StaticResource ConnectionButton}" Content="连接 →" Click="Connect_Click" Margin="0,0,14,0"/><Button Style="{StaticResource ConnectionLink}" Content="上一步" Click="ConnectionPrevious_Click"/></WrapPanel>
                                        <TextBlock x:Name="ConnectionFeedback" Style="{StaticResource ConnectionCaption}" Margin="0,14,0,0" AutomationProperties.LiveSetting="Polite"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel x:Name="ConnectionStepThree" Visibility="Collapsed">
                                    <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource LimeWash}" HorizontalAlignment="Left" Margin="0,0,0,20"><TextBlock Text="✓" FontSize="24" Foreground="{DynamicResource LimeDeep}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <TextBlock Text="连接成功" Style="{StaticResource ConnectionHeading}"/>
                                    <Border Style="{StaticResource ConnectionInfo}"><TextBlock x:Name="ConnectedDevicesText" FontSize="17" Foreground="{DynamicResource Ink}" TextWrapping="Wrap"/></Border>
                                    <WrapPanel Margin="0,24,0,0"><Button Style="{StaticResource ConnectionButton}" Content="调整屏幕排列 ↗" Click="ArrangeNow_Click" Margin="0,0,12,8"/><Button Style="{StaticResource ConnectionButton}" Content="完成" Click="FinishConnection_Click" Margin="0,0,0,8"/></WrapPanel>
                                </StackPanel>
                            </Grid>
                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,28,0,0" Padding="0,16,0,0"><Grid><TextBlock Text="局域网连接 · TLS 加密" FontSize="11" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="ConnectionStepCount" Text="步骤 01 / 03" FontSize="11" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/></Grid></Border>
                        </StackPanel>
                        <StackPanel x:Name="ConnectionOverview" Visibility="Collapsed" VerticalAlignment="Top" Margin="32,48" MaxWidth="1120" HorizontalAlignment="Stretch">
                            <TextBlock Text="CONNECTED DEVICES" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource LimeDeep}" Margin="0,0,0,22"/>
                            <TextBlock x:Name="OverviewTitle" Text="设备已连接。" FontSize="46" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" Margin="0,0,0,32"/>
                            <Expander x:Name="PairedDevicesExpander" Header="已配对设备" IsExpanded="True" Foreground="{DynamicResource Ink}" FontSize="14">
                                <StackPanel Margin="0,16,0,0"><TextBlock x:Name="ConnHost" FontSize="13" Foreground="{DynamicResource Ink70}" Margin="0,0,0,12"/>
                                    <ListBox x:Name="PeerList" AutomationProperties.AutomationId="PeerList" AutomationProperties.Name="已配对设备" FontSize="17" MaxHeight="340" Background="Transparent">
                                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="PeerSurface" Background="{DynamicResource Paper2}" BorderBrush="{DynamicResource Line}" BorderThickness="2" CornerRadius="14" Padding="22,18"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="PeerSurface" Property="BorderBrush" Value="{DynamicResource LimeDeep}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PeerSurface" Property="Background" Value="{DynamicResource LimeWash}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate><DataTemplate>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel><TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/><TextBlock Text="{Binding Address}" FontSize="13" Foreground="{DynamicResource Ink70}" Margin="0,8,0,0"/><TextBlock Text="{Binding Error}" FontSize="12" Foreground="{DynamicResource Vein}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                                    <Button Style="{StaticResource PeerIcon}" Click="ReconnectPeer_Click" IsEnabled="{Binding CanOperate}" ToolTip="重新连接" AutomationProperties.Name="重新连接">
                                                        <Path Width="22" Height="22" Stretch="Uniform" Data="M19.3,9 A7.7,7.7 0 1 0 19.5,14.5 M19.3,4.5 V9 H14.8" Stroke="{DynamicResource Ink70}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" RenderTransformOrigin="0.5,0.5">
                                                            <Path.RenderTransform><RotateTransform/></Path.RenderTransform>
                                                            <Path.Style><Style TargetType="Path"><Style.Triggers><DataTrigger Binding="{Binding Busy}" Value="True"><DataTrigger.EnterActions><BeginStoryboard x:Name="ReconnectSpin"><Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.8" RepeatBehavior="Forever"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions><DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="ReconnectSpin"/></DataTrigger.ExitActions></DataTrigger></Style.Triggers></Style></Path.Style>
                                                        </Path>
                                                    </Button>
                                                    <Button Style="{StaticResource PeerIcon}" Click="RemovePeer_Click" IsEnabled="{Binding CanOperate}" ToolTip="移除设备" AutomationProperties.Name="移除设备"><Path Width="22" Height="22" Stretch="Uniform" Data="M4.5,6.5 H19.5 M9,6.5 V4.8 Q9,3.5 10.2,3.5 H13.8 Q15,3.5 15,4.8 V6.5 M6.5,6.5 L7.3,18.7 Q7.4,20.5 9.1,20.5 H14.9 Q16.6,20.5 16.7,18.7 L17.5,6.5 M10,10 V16.5 M14,10 V16.5" Stroke="{DynamicResource Ink70}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Button>
                                                    <TextBlock Text="{Binding Status}" FontSize="13" Foreground="{DynamicResource LimeDeep}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Expander>
                            <WrapPanel Margin="0,24,0,0"><Button Style="{StaticResource ConnectionButton}" Content="连接新设备" Click="AddConnection_Click" Margin="0,0,22,10"/><Button Style="{StaticResource ConnectionLink}" Content="调整屏幕排列 ↗" Click="ArrangeNow_Click" Margin="0,0,0,10"/></WrapPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- 02 屏幕排列 -->
            <Grid x:Name="PanelArr" Grid.Row="1">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border x:Name="Stage" AutomationProperties.AutomationId="Stage" BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource GridBrush}"
                        AllowDrop="False" Focusable="True" FocusVisualStyle="{StaticResource FocusRing}" ClipToBounds="True"
                        AutomationProperties.Name="屏幕排列画布，拖动设备调整上下左右位置，方向键移动选中设备"
                        SizeChanged="Stage_SizeChanged" MouseMove="Stage_MouseMove" MouseLeave="Stage_Leave" KeyDown="Stage_KeyDown"
                        DragEnter="Stage_DragOver" DragOver="Stage_DragOver" DragLeave="Stage_Leave" Drop="Stage_Drop">
                    <Grid>
                        <ItemsControl x:Name="Screens" IsHitTestVisible="True">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}"/><Setter Property="Canvas.Top" Value="{Binding Y}"/></Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Grid Width="{Binding SlotW}" Height="{Binding SlotH}">
                                    <Border Width="{Binding W}" Height="{Binding H}" HorizontalAlignment="Left" VerticalAlignment="Top" MouseLeftButtonDown="Screen_MouseDown" MouseLeftButtonUp="Screen_MouseUp" LostMouseCapture="Screen_LostCapture" Background="{DynamicResource Paper}" BorderBrush="{DynamicResource Ink}" BorderThickness="1.5" Cursor="Hand">
                                        <Grid ClipToBounds="True">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <TextBlock x:Name="ScreenName" Text="{Binding Name}" FontFamily="Microsoft YaHei" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis" Margin="16,14,16,0"/>
                                            <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" Margin="20,12"><TextBlock Text="{Binding Res}" FontFamily="Microsoft YaHei" FontSize="38" Foreground="{DynamicResource Ink70}"/></Viewbox>
                                            <TextBlock Grid.Row="2" Text="{Binding Role}" FontFamily="Microsoft YaHei" FontSize="12" Foreground="{DynamicResource Muted}" Margin="16,0,16,14"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers><DataTrigger Binding="{Binding Primary}" Value="True"><Setter TargetName="ScreenName" Property="Foreground" Value="{DynamicResource LimeDeep}"/></DataTrigger></DataTemplate.Triggers>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Canvas x:Name="LayoutLinks"/>
                        <Canvas IsHitTestVisible="False"><Rectangle x:Name="DropPreview" Visibility="Collapsed" Stroke="{DynamicResource LimeDeep}" StrokeThickness="2" StrokeDashArray="4,3" Fill="{DynamicResource LimeWash}" Opacity="0.6"/></Canvas>
                    </Grid>
                </Border>
                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <TextBlock Style="{StaticResource Caption}" Text="拖动屏幕调整位置。" MaxWidth="560" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="ScreenCount" Style="{StaticResource Mono}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                </Grid>
            </Grid>

            <!-- 03 设置 -->
            <Grid x:Name="PanelSet" Grid.Row="1" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="5*" MinWidth="280"/><ColumnDefinition Width="32"/><ColumnDefinition Width="4*" MinWidth="240"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel AutomationProperties.Name="文件与剪贴板">
                        <TextBlock Text="文件与剪贴板" Style="{StaticResource Section}"/>
                        <CheckBox x:Name="ClipboardCheck" AutomationProperties.AutomationId="ClipboardCheck" Style="{StaticResource Square}" Content="同步剪贴板（文字、图片、文件）" IsChecked="{Binding ClipboardSettings.SharingEnabled, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                        <CheckBox x:Name="HistoryEnabledCheck" AutomationProperties.AutomationId="HistoryEnabledCheck" Style="{StaticResource Square}" Content="记录剪贴板历史" IsChecked="{Binding ClipboardSettings.HistoryEnabled, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                        <TextBlock Text="历史快捷键" Style="{StaticResource Caption}"/>
                        <Button x:Name="ClipboardHotkeyButton" AutomationProperties.AutomationId="ClipboardHotkeyButton" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,8,0,16" Content="{Binding ClipboardSettings.HotkeyText, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Click="Hotkey_Click" PreviewKeyDown="Hotkey_KeyDown" LostKeyboardFocus="ClipboardHotkey_LostFocus"/>
                        <TextBlock Text="历史条数上限（0 表示不限条数）" Style="{StaticResource Caption}"/>
                        <TextBox x:Name="MaxItemsBox" AutomationProperties.AutomationId="MaxItemsBox" Text="{Binding ClipboardSettings.MaxItems, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" HorizontalAlignment="Left" Width="120" Margin="0,8,0,16" PreviewTextInput="MaxItems_PreviewTextInput" DataObject.Pasting="MaxItems_Pasting" LostKeyboardFocus="MaxItems_LostFocus"/>
                        <CheckBox x:Name="RecordImagesCheck" AutomationProperties.AutomationId="RecordImagesCheck" Style="{StaticResource Square}" Content="记录图片" IsChecked="{Binding ClipboardSettings.CaptureImages, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                        <CheckBox x:Name="RecordFilesCheck" AutomationProperties.AutomationId="RecordFilesCheck" Style="{StaticResource Square}" Content="记录文件" IsChecked="{Binding ClipboardSettings.CaptureFiles, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                        <TextBlock Style="{StaticResource Caption}" Text="桌面与资源管理器原生拖放；默认复制，不删除源文件。"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" AutomationProperties.Name="外观与系统">
                    <TextBlock Text="外观与系统" Style="{StaticResource Section}"/>
                    <CheckBox x:Name="DarkCheck" AutomationProperties.AutomationId="DarkCheck" Style="{StaticResource Square}" Content="深色主题" Checked="Theme_Changed" Unchecked="Theme_Changed"/>
                    <CheckBox x:Name="StartWithWindowsCheck" AutomationProperties.AutomationId="StartWithWindowsCheck" Style="{StaticResource Square}" Content="开机时启动" Checked="Startup_Changed" Unchecked="Startup_Changed"/>
                    <TextBlock Text="剪贴板与开机启动即时保存。深色主题仅本次窗口生效。" Style="{StaticResource Caption}"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 状态栏：传输内置于此 -->
        <Grid Grid.Row="2" Grid.ColumnSpan="2">
            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"/>
            <Rectangle x:Name="TransferBar" Height="2" VerticalAlignment="Top" HorizontalAlignment="Left" Width="0" Fill="{DynamicResource Lime}"/>
            <TextBlock x:Name="FootLeft" Style="{StaticResource Mono}" HorizontalAlignment="Left" Margin="24,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,0">
                <TextBlock Text="传输" Style="{StaticResource Mono}"/>
                <TextBlock x:Name="TransferText" AutomationProperties.AutomationId="TransferText" Text="无" Style="{StaticResource Mono}" Foreground="{DynamicResource Ink70}" Margin="8,0,0,0"/>
                <Rectangle Width="1" Height="12" Fill="{DynamicResource Line}" Margin="16,0"/>
                <TextBlock x:Name="ShareText" Text="共享未启动" Style="{StaticResource Mono}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
